{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": false,
    "inlineSources": false,
    "isolatedModules": true,
    "lib": [
      "DOM",
      "ES2018"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2018",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}
